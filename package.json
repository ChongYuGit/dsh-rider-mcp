{
  "name": "dsh-rider-mcp",
  "version": "0.1.0",
  "description": "Connect DeepSeek Harness to JetBrains Rider's built-in MCP server, with a per-session project picker and connection badge.",
  "type": "module",
  "license": "MIT",
  "author": "ChongYuGit",
  "homepage": "https://github.com/ChongYuGit/dsh-rider-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChongYuGit/dsh-rider-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ChongYuGit/dsh-rider-mcp/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "jetbrains",
    "rider",
    "mcp",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "session-runtime.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
